# Python 运行时产物与本地环境
backend/.venv
backend/uploads
backend/data
backend/logs
backend/*.db
backend/.env
backend/tests
**/__pycache__

# 前端本地构建产物与依赖（镜像内多阶段重新构建）
frontend/node_modules
frontend/dist
frontend/tsconfig.tsbuildinfo
frontend/vite.config.ts.timestamp-*.mjs

# 通用依赖与系统文件
node_modules
**/node_modules
**/.DS_Store

