# Agnes AI Platform 后端环境变量示例

# ============================================================
# 【引导配置】Agnes AI API Key（仅首次启动初始化默认 Provider 用）
# 启动后这些值会被写入数据库 api_providers 表，
# 后续在前端配置页（/settings）管理 Provider 和 API Key。
#
# 如果留空，首次启动不会创建默认 Provider，
# 需要手动在前端配置页添加 Provider。
# ============================================================
AGNES_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Agnes AI API 基础地址（仅首次启动初始化默认 Provider 用）
# ============================================================
AGNES_API_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_POLL_URL=https://apihub.agnes-ai.com/agnesapi

# ============================================================
# 【必填·安全】API Key 加密密钥
# 用于加密数据库中存储的 Provider API Key（Fernet 对称加密）。
# 必须配置为随机字符串（建议 32 字符以上），留空时服务无法启动。
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 修改此密钥后，已加密的 API Key 将无法解密，需要重新配置 Provider。
# ============================================================
ENCRYPTION_KEY=please-change-this-to-a-random-string-at-least-32-chars-long

# ============================================================
# 【必填·安全】JWT 签名密钥
# 用于签发和校验用户登录 Token（HS256 对称签名）。
# 必须配置为随机字符串（至少 32 字节），留空时服务无法启动。
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 修改此密钥后，所有已签发的 Token 立即失效，用户需重新登录。
# ============================================================
JWT_SECRET=please-change-this-to-a-random-string-at-least-32-bytes-long
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================================
# 数据库（默认 SQLite，零配置；如需 PostgreSQL 可替换）
# ============================================================
# SQLite（默认）
DATABASE_URL=sqlite:///./agnes_platform.db
# PostgreSQL（可选）
# DATABASE_URL=postgresql://username:password@localhost:5432/agnes_platform

# ============================================================
# 服务配置
# ============================================================
BACKEND_PORT=8000

# ============================================================
# CORS - 允许的前端来源（逗号分隔，多值）
# 开发模式下默认 http://localhost:5173
# ============================================================
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# 业务参数（通常无需修改）
# ============================================================
MAX_UPLOAD_SIZE_MB=10
VIDEO_POLL_INTERVAL_SEC=5
VIDEO_POLL_TIMEOUT_SEC=600

# 新注册用户默认赠送的积分
NEW_USER_DEFAULT_CREDITS=500

# ============================================================
# 邮件服务配置（用于发送验证码等）
# 留空 SMTP_HOST 则不启用邮件功能
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Agnes AI Platform
SMTP_USE_TLS=true

# ============================================================
# 验证码配置
# ============================================================
# 图片验证码有效期（秒），默认 5 分钟
CAPTCHA_EXPIRE_SECONDS=300
# 邮箱验证码有效期（秒），默认 10 分钟
EMAIL_CODE_EXPIRE_SECONDS=600
# 邮箱验证码重发间隔（秒），默认 60 秒
EMAIL_CODE_RESEND_INTERVAL=60

# ============================================================
# 对象存储配置（用于资源转存，S3 兼容协议）
# 支持任何 S3 兼容服务商：Cloudflare R2 / AWS S3 / MinIO / 阿里云 OSS（S3 兼容模式）
# 未配置时跳过转存，所有 URL 走原始上游
#
# Cloudflare R2 配置示例：
#   STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   STORAGE_REGION=auto
#   STORAGE_PUBLIC_URL_BASE=https://pub-xxx.r2.dev  (在 R2 桶设置中开启公共访问后获取)
#
# AWS S3 配置示例：
#   STORAGE_ENDPOINT=  (留空，boto3 自动按 region 推断)
#   STORAGE_REGION=us-east-1
#   STORAGE_PUBLIC_URL_BASE=https://<bucket>.s3.amazonaws.com
#
# MinIO 配置示例：
#   STORAGE_ENDPOINT=http://localhost:9000
#   STORAGE_REGION=us-east-1
#   STORAGE_PUBLIC_URL_BASE=http://localhost:9000/<bucket>
STORAGE_BACKEND_TYPE=s3
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_PUBLIC_URL_BASE=
STORAGE_VIDEO_UPLOAD_TIMEOUT_SEC=120
STORAGE_IMAGE_UPLOAD_TIMEOUT_SEC=30
STORAGE_MIGRATE_RETRY_MAX=2
STORAGE_MIGRATE_RETRY_INTERVAL_SEC=5

# ============================================================
# 日志配置
# ============================================================
# 全局日志级别（DEBUG/INFO/WARNING/ERROR/CRITICAL）
LOG_LEVEL=INFO
# 是否启用文件日志（生产环境建议开启）
LOG_FILE_ENABLED=true
# 日志文件存储目录
LOG_DIR=./logs
# 单个日志文件最大字节数（默认 10MB）
LOG_MAX_BYTES=10485760
# 日志文件轮转备份数量
LOG_BACKUP_COUNT=5
# 是否启用 JSON 格式错误日志（WARNING 及以上输出 JSON，便于 Agent 解析）
LOG_JSON_ENABLED=true
